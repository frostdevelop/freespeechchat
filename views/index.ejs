<!DOCTYPE HTML>
<html lang="en">
  <head>
    <title> Chat </title>
    <meta name = "charset" charset = "utf-8">
    <meta name = "viewport" content = "width=device-width">
    <meta name="description" content = "A chat app made by Pacifiky">
    <meta name="author" content = "Pacifiky">
    <link rel = "stylesheet" type = "text/css" href = "style.css">
    <script>var frostMir = '<%= mir %>'</script>
    <script src = "script.js"></script>
    <script src = "system.js"></script>
    <script src= "socket.io/socket.io.js"></script>
    <link rel = "icon" href = "favicon.png">
  </head>
  <body onload = "onload()">
    <main>
      <header>
      <img src="favicon.png" alt="logo" height="40px">  
      <h1 id = "Title">Free Speech</h1>
      </header>
      <div class="indentsection">
      <p>Socket.io Chat</br>Design By infinitypacific</p>
      </div>
      <div id = "AccessPort" class = "section layer1 indentsection">
        <h2>Login</h2>
        <label id = "NameLabel"> Username </label>
        <input id = "NameInput" type = "text" class="txbttn" placeholder="Enter a Username...">
        <label id = "PfpLabel"> Profile Picture </label>
        <input id = "PfpInput" type = "link" class="txbttn" placeholder="Enter a Link...">
        <label id = "IDLabel"> Chatroom </label>
        <input id = "IDInput" value = "Room1" type = "text" class="txbttn" placeholder="Enter a roomID...">
        <input id = "ConnectButton" class = "Button" type = "button" value = "Connect" onclick = "Connect()">
      </div>
      <div id = "ChatSection" class = "section layer1">
      <div id = "ChatContainer">
      <div class="header layer2 shadow">
        <h2 id = "RoomID" class = "nomargin"> Chatroom : None </h2>
      </div>
      <ul id = "Chat" class = "layer1 nomargin">
      </ul>
      <ul id="Tree" class=" layer3 nomargin shadow">
      </ul>
      <div id="MessageForm" class="layer1 nomargin">
        <form id="msgform">
        <textarea id = "ComposedMessage" class="txbttn layer4" placeholder="Enter your message here..." rows="1"></textarea>
        <input type="reset" id="resetmsg"></input>
        </form>
        <!--<input id = "SendMessage" onclick="Send()" value = "Send" class = "Button" type = "submit">-->
      </div>
      </div>
      </div>
    </main>
    <div id="System">
    <div id="popup"></div>
    <div id="toast"></div>
    <div id="audio">
      <audio id = "Ding" src = "audio/Ding.mp3"> </audio>
      <audio id = "Notify" src = "audio/Pogo_Notification.m4a"> </audio>
      <audio id = "Connecting" src = "audio/Pogo_Connecting.m4a"> </audio>
      <audio id = "R" src = "audio/Pogo_R.m4a"> </audio>
      <audio id = "S" src = "audio/Pogo_S.m4a"> </audio>
      <audio id = "Disabled" src = "audio/Pogo_Disabled.m4a"> </audio>
      <audio id = "Connect" src = "audio/Pogo_Connect.m4a"> </audio>
      <audio id = "Disconnect" src = "audio/Pogo_Disconnect.m4a"> </audio>
      <audio id = "Alert" src = "audio/Pogo_Alert.m4a"> </audio>
    </div>
    <div id="svgs">
      <svg>
        <defs>
          <symbol id="svg-alert">
            <g>
            <path d="M12.5124 1.57143C12.9513 0.809523 14.0487 0.809524 14.4876 1.57143L25.8455 21.2857C26.2845 22.0476 25.7358 23 24.8579 23H2.14213C1.26423 23 0.715539 22.0476 1.15449 21.2857L12.5124 1.57143Z" stroke-width="1.5"/>
            <path d="M13.5 17.5C13.0534 17.5 12.7762 17.191 12.75 16.7953L12.25 6.83333C12.1993 6.06874 12.637 5.5 13.5 5.5C14.363 5.5 14.8007 6.06874 14.75 6.83333L14.25 16.7953C14.2238 17.191 13.9466 17.5 13.5 17.5Z" fill="currentcolor"/>
            <path d="M12.375 19.625C12.375 19.0037 12.8787 18.5 13.5 18.5C14.1213 18.5 14.625 19.0037 14.625 19.625C14.625 20.2463 14.1213 20.75 13.5 20.75C12.8787 20.75 12.375 20.2463 12.375 19.625Z" fill="currentcolor"/>
            </g>
          </symbol>
          <symbol id="svg-copy">
            <path d="M10.9 28.25H26V33H5V8H9.9V27.25V28.25H10.9Z" stroke="currentcolor" stroke-width="2"></path>
            <path d="M30 28H10V3H21.7792L30 11.4076V28Z" stroke="currentcolor" stroke-width="2"></path>
            <path d="M20 2L31 13H20V2Z" fill="currentcolor"></path>
          </symbol>
        </defs>
      </svg>
    </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@3.2.4/dist/purify.min.js"></script>
  </body>
</html>